      "proposalId": "p-001",
      "version": 1,
      "rationale": "To enhance reading comprehension skills among Grade 7-10 students through an intensive reading camp that promotes literacy and critical thinking.",
      "objectives": ["Improve reading comprehension scores by 15%", "Develop critical thinking skills through literature analysis", "Foster a love for reading among students"],
      "expectedOutputs": "At least 80% of participants show improvement in reading comprehension post-test scores.",
      "implementationPlan": [
        { "activity": "Pre-assessment of reading levels", "date": "2026-09-01", "responsible": "Luisa Garcia", "output": "Assessment results" },
        { "activity": "Reading camp proper (5 days)", "date": "2026-09-15", "responsible": "Luisa Garcia", "output": "Completed camp activities" },
        { "activity": "Post-assessment", "date": "2026-09-22", "responsible": "Luisa Garcia", "output": "Post-test results" }
      ],
      "budget": [
        { "particular": "Reading materials", "qty": 50, "unitCost": 150 },
        { "particular": "Snacks for participants", "qty": 50, "unitCost": 100 },
        { "particular": "Certificates", "qty": 50, "unitCost": 25 }
      ],
      "fundingSource": "School MOOE",
      "targetParticipants": "50 Grade 7-10 students with reading difficulties",
      "proposedDate": "2026-09-15",
      "venue": "Sorsogon National High School Library",
      "attachments": ["reading_camp_design.pdf", "pre_assessment_tool.docx"],
      "submittedAt": ""
    },
